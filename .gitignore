# Toolchain output. Regenerated by every build.
*.uf2
*.hex
*.bin
*.elf
*.eep
*.map
*.lst

# Release artifacts are tracked so the release.json SHA-256 fields can be
# verified from a clean clone. Everything else under build/ stays untracked.
build/**
!build/mcb/
!build/bms/
!build/gs/
!build/mcb/MCB.ino.uf2
!build/bms/BMS.ino.hex
!build/gs/GS.ino.hex

.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.code-workspace
.idea/

# Local IDE state. The MCB board profile stays in the tree.
MCB/.vscode/*
!MCB/.vscode/arduino.json
